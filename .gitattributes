#
# https://help.github.com/articles/dealing-with-line-endings/
#

# Normalise every text file to LF in the repository, on every platform.
# The whole project (sources, json assets, gradle scripts) is authored with LF.
* text=auto eol=lf

# Linux start script should use lf
/gradlew        text eol=lf

# These are Windows script files and should use crlf
*.bat           text eol=crlf

# Binary assets - never let git touch their line endings
*.jar           binary
*.zip           binary
*.png           binary
*.ttf           binary
*.otf           binary
*.woff          binary
*.woff2         binary
*.ogg           binary
*.nbt           binary
*.pdf           binary
